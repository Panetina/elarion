{
  "version": 1,
  "defaultBudgetTokens": 6000,
  "maximumStandardTokens": 12000,
  "maximumCrossModuleTokens": 24000,
  "domains": [
    {
      "id": "external-platform",
      "keywords": ["website", "launcher", "discord", "bridge", "projection", "pebblehost", "deploy", "live server"],
      "owner": "Fabric owns canonical game truth; website/launcher/Discord own only their explicit external domains",
      "docs": ["docs/systems/MinecraftBridge.md", "docs/systems/LiveDeployment.md", "docs/systems/Distribution.md", "docs/architecture/DEPENDENCY_GRAPH.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/integration/minecraft/*.java", "addons/*/src/main/java/**/*WebProjection*.java", "dev/tools/deploy-live-server.ps1", "distribution/mods.json", "build.gradle"],
      "testGlobs": ["platform/core/src/test/java/**/integration/minecraft/*.java", "addons/*/src/test/java/**/*WebProjection*.java"],
      "commands": [".\\gradlew.bat prepareLiveServerRelease"],
      "companionChecks": ["canonical ownership", "bounded signed projection", "no external canonical state", "explicit deployment approval", "remote backup", "post-start verification"]
    },
    {
      "id": "placeholders",
      "keywords": ["placeholder", "token", "substitution", "formatter", "template", "compatibility alias"],
      "owner": "platform/core contracts; each addon owns its domain values",
      "docs": ["docs/config.md", "docs/systems/Chronicles.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/*.java", "addons/*/src/main/java/**/*.java"],
      "testGlobs": ["platform/core/src/test/java/**/*.java", "addons/*/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["canonical owner", "visibility", "missing-data behavior", "bounded resolution", "no rendering-time IO", "aliases", "cycle and output limits"]
    },
    {
      "id": "core",
      "keywords": ["core", "citizen", "ember", "realm", "identity", "title", "reward", "permission", "profile", "character menu"],
      "owner": "platform/core",
      "docs": ["docs/architecture/DEPENDENCY_GRAPH.md", "docs/addons/core.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/*.java"],
      "testGlobs": ["platform/core/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["ownership", "api", "events", "notifications"]
    },
    {
      "id": "config",
      "keywords": ["config", "yaml", "definition", "descriptor", "reload", "default"],
      "owner": "domain owner; Core owns the descriptor registry",
      "docs": ["docs/config.md", "docs/systems/Persistence.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/*Config*.java", "addons/*/src/main/java/**/*Config*.java"],
      "testGlobs": ["platform/core/src/test/java/**/*Config*.java", "addons/*/src/test/java/**/*Config*.java"],
      "commands": [".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["typed runtime snapshot", "validation", "reload safety", "read-only descriptors", "descriptor tests", "docs/config.md"]
    },
    {
      "id": "networking",
      "keywords": ["packet", "payload", "network", "receiver", "codec", "sync"],
      "owner": "Core patterns; each addon owns its feature payloads",
      "docs": ["docs/systems/Networking.md", "docs/fabric-reference/Networking.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/network/*.java", "addons/*/src/main/java/**/network/*.java"],
      "testGlobs": ["platform/core/src/test/java/**/network/*.java", "addons/*/src/test/java/**/network/*.java"],
      "commands": [".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["payload registration", "server-authoritative validation", "bounded snapshot", "packet tests"]
    },
    {
      "id": "gui",
      "keywords": ["gui", "ui", "screen", "hud", "layout", "button", "tooltip", "render"],
      "owner": "Core shared primitives; addon-specific screens remain addon-owned",
      "docs": ["docs/systems/GUI.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/client/**/*.java", "addons/*/src/main/java/**/client/**/*.java"],
      "testGlobs": ["platform/core/src/test/java/**/client/**/*.java", "addons/*/src/test/java/**/client/**/*.java"],
      "commands": [".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["shared UI primitives", "layout tests", "live screenshot QA when visual behavior changes"]
    },
    {
      "id": "persistence",
      "keywords": ["storage", "persist", "state", "json", "jsonl", "restart", "round trip", "archive"],
      "owner": "Core shared storage patterns; state remains domain-owned",
      "docs": ["docs/systems/Persistence.md", "docs/history.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/storage/*.java", "addons/*/src/main/java/**/storage/*.java"],
      "testGlobs": ["platform/core/src/test/java/**/storage/*.java", "addons/*/src/test/java/**/storage/*.java"],
      "commands": [".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["round trip", "reload", "restart", "atomic write", "bounded query path"]
    },
    {
      "id": "atlas",
      "keywords": ["atlas", "map", "terrain", "discovery", "marker", "heraldry", "npc pin", "worlds map"],
      "owner": "addons/atlas for rendering/discovery projections; Core and domain addons retain canonical truth",
      "docs": ["docs/systems/Atlas.md", "docs/addons/atlas.md", "docs/architecture/DEPENDENCY_GRAPH.md"],
      "sourceGlobs": ["addons/atlas/src/main/java/**/*.java"],
      "testGlobs": ["addons/atlas/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:atlas:test :addons:atlas:build"],
      "companionChecks": ["shell versus operational status", "canonical owner", "bounded regions", "server-side visibility masking", "no direct addon storage access", "website read-model boundary"]
    },
    {
      "id": "commands",
      "keywords": ["command", "brigadier", "permission", "help", "suggestion", "game test"],
      "owner": "Core command roots; addons own feature subcommands",
      "docs": ["docs/commands.md", "docs/test-commands.md", "docs/fabric-reference/Commands.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/command/*.java", "addons/*/src/main/java/**/command/*.java"],
      "testGlobs": ["tests/gametest/src/**/*.java", "platform/core/src/test/java/**/command/*.java", "addons/*/src/test/java/**/command/*.java"],
      "commands": [".\\gradlew.bat :tests:gametest:runGameTest"],
      "companionChecks": ["registration", "permission", "help", "suggestions", "execution", "admin wiki"]
    },
    {
      "id": "chronicles",
      "keywords": ["chronicle", "history", "newspaper", "ledger", "rumor", "variant", "public history"],
      "owner": "platform/core",
      "docs": ["docs/systems/Chronicles.md", "docs/history.md"],
      "sourceGlobs": ["platform/core/src/main/java/**/*History*.java", "platform/core/src/main/java/**/*Chronicle*.java", "addons/*/src/main/java/**/*Chronicle*.java"],
      "testGlobs": ["platform/core/src/test/java/**/*History*.java", "platform/core/src/test/java/**/*Chronicle*.java", "addons/*/src/test/java/**/*Chronicle*.java"],
      "commands": [".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["publicHistory API", "bounded index", "stable variants", "metadata fallback", "no raw player-facing JSONL scan"]
    },
    {
      "id": "npcs",
      "keywords": ["npc", "dialogue", "conversation", "banker", "trader", "relationship", "story flag"],
      "owner": "addons/npcs",
      "docs": ["docs/systems/NPCs.md", "docs/addons/npcs.md"],
      "sourceGlobs": ["addons/npcs/src/main/java/**/*.java"],
      "testGlobs": ["addons/npcs/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:npcs:test"],
      "companionChecks": ["server-authored dialogue", "NPC-owned state", "registered actions and conditions", "meaningful lifecycle events"]
    },
    {
      "id": "economy",
      "keywords": ["economy", "currency", "bank", "balance", "treasury", "transaction", "tax", "price"],
      "owner": "addons/economy",
      "docs": ["docs/addons/economy.md", "docs/systems/Treasury.md"],
      "sourceGlobs": ["addons/economy/src/main/java/**/*.java"],
      "testGlobs": ["addons/economy/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:economy:test"],
      "companionChecks": ["idempotency", "transaction journal", "authoritative pricing", "no duplicated Realm or NPC state"]
    },
    {
      "id": "offerings",
      "keywords": ["offering", "shrine", "contribution", "milestone", "donation"],
      "owner": "addons/offerings",
      "docs": ["docs/systems/CommunityContribution.md", "docs/addons/offerings.md"],
      "sourceGlobs": ["addons/offerings/src/main/java/**/*.java"],
      "testGlobs": ["addons/offerings/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:offerings:test"],
      "companionChecks": ["bounded progress", "server-authoritative contribution", "rewards", "events and notifications"]
    },
    {
      "id": "government",
      "keywords": ["government", "civic", "proposal", "vote", "office", "law", "seat of rule", "forum"],
      "owner": "addons/government",
      "docs": ["docs/systems/Government.md", "docs/addons/government.md"],
      "sourceGlobs": ["addons/government/src/main/java/**/*.java"],
      "testGlobs": ["addons/government/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:government:test"],
      "companionChecks": ["Realm truth remains Core-owned", "server-issued UI session", "vote persistence", "events and notifications"]
    },
    {
      "id": "quests",
      "keywords": ["quest", "questline", "objective", "consequence", "actor binding"],
      "owner": "addons/quests",
      "docs": ["docs/systems/Quests.md", "docs/addons/quests.md"],
      "sourceGlobs": ["addons/quests/src/main/java/**/*.java"],
      "testGlobs": ["addons/quests/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:quests:test"],
      "companionChecks": ["quest-owned runtime state", "registered actions and conditions", "bounded consequences", "no NPC or Offering state duplication"]
    },
    {
      "id": "portals",
      "keywords": ["portal", "gate", "ticket", "route", "travel", "return entitlement"],
      "owner": "addons/portals",
      "docs": ["docs/systems/Portals.md", "docs/addons/portals.md"],
      "sourceGlobs": ["addons/portals/src/main/java/**/*.java"],
      "testGlobs": ["addons/portals/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:portals:test"],
      "companionChecks": ["server travel validation", "route state", "tickets and fees", "return entitlement", "prompt QA"]
    },
    {
      "id": "underworld",
      "keywords": ["underworld", "death", "grave", "corpse", "soul fracture", "true death", "recovery"],
      "owner": "addons/underworld",
      "docs": ["docs/systems/Underworld.md", "docs/systems/Characters.md", "docs/addons/underworld.md"],
      "sourceGlobs": ["addons/underworld/src/main/java/**/*.java", "platform/core/src/main/java/**/*CharacterLifecycle*.java"],
      "testGlobs": ["addons/underworld/src/test/java/**/*.java", "platform/core/src/test/java/**/*CharacterLifecycle*.java"],
      "commands": [".\\gradlew.bat :addons:underworld:test", ".\\gradlew.bat :platform:core:test"],
      "companionChecks": ["component preservation", "authorization", "restart reconciliation", "Core True Death handoff"]
    },
    {
      "id": "angling",
      "keywords": ["angling", "fishing", "fish", "bobber", "bait", "tournament", "catch", "farmer's delight", "starcatcher"],
      "owner": "addons/angling for fishing runtime; Core for accepted catches, rewards, titles, metrics, rankings, and events",
      "docs": ["docs/addons/angling.md", "docs/systems/CatchTelemetry.md", "docs/systems/Metrics.md", "docs/architecture/DEPENDENCY_GRAPH.md"],
      "sourceGlobs": ["addons/angling/src/main/java/**/*.java", "addons/angling/porting/*.json", "addons/angling-delight/src/main/java/**/*.java", "addons/angling-delight/porting/*.json", "platform/core/src/main/java/**/*Catch*.java", "platform/core/src/main/java/**/metric/*.java"],
      "testGlobs": ["addons/angling/src/test/java/**/*.java", "addons/angling-delight/src/test/java/**/*.java", "platform/core/src/test/java/**/*Catch*.java", "platform/core/src/test/java/**/metric/*.java"],
      "commands": [".\\gradlew.bat :addons:angling:check", ".\\gradlew.bat :addons:angling-delight:check"],
      "companionChecks": ["frozen source revision", "parity disposition", "server authority", "bounded hot paths", "Core catch truth", "release exclusion"]
    },
    {
      "id": "backpacks",
      "keywords": ["backpack", "trinket", "accessory", "chest back", "yyzsbackpack", "bag", "skin"],
      "owner": "Yyz's Backpack for backpack item/container/UI truth; Trinkets for slots; addons/backpacks for Elarion acquisition policy",
      "docs": ["docs/addons/backpacks.md", "docs/systems/Distribution.md", "docs/systems/Underworld.md"],
      "sourceGlobs": ["addons/backpacks/src/main/java/**/*.java", "distribution/mods.json"],
      "testGlobs": ["addons/backpacks/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:backpacks:test :addons:backpacks:build"],
      "companionChecks": ["no crafting/smithing/dyeing", "Creative availability", "Trinkets back-slot compatibility", "component preservation", "official-origin pins"]
    },
    {
      "id": "mounts",
      "keywords": ["mount", "wyvern", "flight", "geckolib", "collection preview", "rideable"],
      "owner": "addons/mounts",
      "docs": ["docs/addons/mounts.md", "docs/systems/GUI.md"],
      "sourceGlobs": ["addons/mounts/src/main/java/**/*.java"],
      "testGlobs": ["addons/mounts/src/test/java/**/*.java"],
      "commands": [".\\gradlew.bat :addons:mounts:test"],
      "companionChecks": ["server-authoritative movement", "Collection provider", "render bounds", "live visual QA"]
    }
  ]
}
